# =============================================================================
# ARIA & Voice Chat Gemini - Environment Variables
# =============================================================================

# Google Gemini API Keys (get from https://aistudio.google.com/apikey)
# You can use multiple keys for rotation (google_api_1, google_api_2, etc.)
google_api=your_gemini_api_key_here
# google_api_1=your_first_api_key
# google_api_2=your_second_api_key

# Mangisoz API Keys for Kazakh STT (comma-separated for rotation)
# MANGISOZ_API_KEYS=key1,key2,key3

# OpenWeather API Key (get from https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_api_key_here
# Default city for weather
DEFAULT_CITY=Almaty


MIC_DENOISE=full
# off | hpf | full
MIC_HPF_HZ=120
# try 80 if voice sounds too thin, 150 for stronger hum
MIC_GATE_OVERSUB=2.0
# 1.0-3.0 -- higher = cleaner but more artifacts
MIC_GATE_FLOOR=0.02
# 0.01-0.1 -- min fraction kept per bin; lower = deeper suppression
MIC_GATE_TIME_SMOOTH=0.6
# 0.0-0.9 -- higher = smoother mask, less "musical noise"
MIC_NOISE_MARGIN=1.35
# 1.0-2.0 -- multiplies learned noise profile. Higher = more suppression but can dull voice.
MIC_NOISE_TRACK_RMS=0.04
# frames with RMS below this are treated as "quiet" and update the noise profile
MIC_NOISE_TRACK_ALPHA=0.985
# 0.9-0.999 -- EMA coefficient for continuous profile tracking; higher = slower update

# ── ESP32 speaker protection ─────────────────────────────────────────────────
# The firmware multiplies every sample by this before sending to the amp.
# Mirror what's in esp-32-wroom.ino (speakerGain). Our server limiter accounts
# for this so effective peak at the amp = TTS_PEAK_CEILING * ESP32_FIRMWARE_GAIN.
ESP32_FIRMWARE_GAIN=2.0

# Peak ceiling applied by the server BEFORE the firmware's 2x gain (0.0-1.0).
# 0.25 here -> ~0.50 peak at the amp, which both (a) halves peak current and
# (b) quarters peak power versus full scale, keeping the MAX98357A safely out
# of its UVLO range on typical USB supplies AND keeping sustained current
# low enough that USB-PSU over-current protection won't trip during long
# TTS replies. Drop to 0.18 if loud bot speech still causes dropouts;
# raise to 0.35 for louder output if your PSU can handle it.
TTS_PEAK_CEILING=0.25

# High-pass cutoff (Hz) on outgoing speaker audio. Sub-150 Hz content draws
# a disproportionate share of amp current on tiny drivers but adds no speech
# intelligibility. 150 is a good default; try 200 for more headroom.
SPK_HPF_HZ=150